# Copy to .env for local dev. In production (Hostinger/Render), set these as
# real environment variables instead of committing a .env file.

# Long random string used to sign session cookies. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=change-me

PORT=3001

# Where the SQLite users database lives on disk.
DB_PATH=./data/manyouscript.db

# Path B only (server deployed on a different origin than the static site,
# e.g. Render while the frontend is on Hostinger). Leave unset for Path A
# (same-origin) and local dev.
CORS_ORIGIN=

NODE_ENV=development
